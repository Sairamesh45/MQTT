# =================================================================
# MQTT Backend Environment Variables
# Copy this file to .env and fill in your actual values
# =================================================================

# Database Connection — AWS Aurora / RDS (preferred)
DB_HOST=your-cluster.cluster-xxxx.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=postgres
# Optional: path to Aurora CA bundle
# DB_SSL_CA=../my-perro-backend/global-bundle.pem

# Database Connection — Neon (fallback, used only when DB_HOST is not set)
# NEON_DB_URL=postgresql://your_user:your_password@your_host.region.neon.tech:5432/your_database?sslmode=require

# MQTT Broker Configuration (Required)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=admin12

# Mosquitto Dynamic Security Admin (Required)
MOSQUITTO_ADMIN_USER=admin1
MOSQUITTO_ADMIN_PASS=admin1
DYNAMIC_SECURITY_FILE=dynamic-security.json

# Application Server Configuration
PORT=3000
# Use 0.0.0.0 in Docker/AWS to listen on all interfaces
API_HOST=0.0.0.0

# NestJS Backend API (Required)
# All telemetry (location, battery) and isLost events are forwarded here.
# The backend owns all DB writes, hot-field updates, and FCM notifications.
BACKEND_API_URL=http://localhost:4000

# External App API Configuration (legacy, kept for reference)
APP_API_URL=http://localhost:3001/api/location/isLost
DUMMY_APP_HOST=localhost
DUMMY_APP_PORT=3001

# Optional: CORS Configuration
# CORS_ORIGIN=https://your-frontend-domain.com

# Optional: Redis for WebSocket Sessions (for multi-instance deployments)
# REDIS_URL=redis://your-elasticache-endpoint:6379

# =================================================================
# AWS Deployment Notes:
# - Store sensitive values in AWS Secrets Manager or Parameter Store
# - Set MQTT_HOST to your Mosquitto broker's private IP or DNS
# - Set API_HOST=0.0.0.0 for container environments
# - Use Application Load Balancer DNS for APP_API_URL
# - Example: APP_API_URL=http://my-backend-alb.us-east-1.elb.amazonaws.com/api/location/isLost
# =================================================================
